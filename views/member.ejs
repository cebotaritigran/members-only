
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Account</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <nav class="navbar">
    <a href="/" class="logo">Members Only</a>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/user/logout">Log out</a>
    </div>
  </nav>

  <main class="container">

    <% if (user) { %>

      <section class="account-header">
        <h1>My Account</h1>
        <p>Welcome back, <strong><%= user.username %></strong>!</p>
      </section>

      <section class="account-card">

        <h2>Account Information</h2>

        <div class="account-info">
          <div class="info-row">
            <span>Username</span>
            <strong><%= user.username %></strong>
          </div>

          <div class="info-row">
            <span>User ID</span>
            <strong>#<%= user.id %></strong>
          </div>

          <div class="info-row">
            <span>Membership</span>
            <% if (user.member_status) { %>
              <span class="status active">Member</span>
            <% } else { %>
              <span class="status inactive">Not a member</span>
            <% } %>
          </div>

          <div class="info-row">
            <span>Administrator</span>
            <% if (user.admin_status) { %>
              <span class="status active">Yes</span>
            <% } else { %>
              <span class="status inactive">No</span>
            <% } %>
          </div>
        </div>

      </section>

      <section class="account-card">

        <h2>Account Actions</h2>

        <div class="account-actions">

          <a href="/" class="action-link">
            Back to home
          </a>

          <% if (user.admin_status) { %>
            <a href="/user/users" class="action-link">
              Manage users
            </a>
          <% } %>

          <a href="/user/logout" class="action-link logout">
            Log out
          </a>

        </div>

      </section>

    <% } else { %>

      <section class="login-section">
        <h1>Welcome back</h1>
        <p>Log in to access your account.</p>

        <form action="/user/login" method="POST" class="login-form">

          <div>
            <label for="username">Username</label>
            <input id="username" name="username" type="text" required>
          </div>

          <div>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required>
          </div>

          <button type="submit">Log in</button>

        </form>

        <p>Don't have an account? <a href="/user/sign-up">Sign up</a></p>
      </section>

    <% } %>

  </main>

</body>
</html>
