<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
</head>

<body>
    <form action="/user/sign-up" method="post">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" required>
        <br>
        <label for="password">Password:</label>
        <input type="password" id="password" name="password" required>
        <br>
        <label for="memberStatus">Secret Key to gain Member Status:</label>
        <input type="text" id="memberStatus" name="memberStatusKey" />
        <br />
        <label for="adminStatus">Admin Key:</label>
        <input type="text" id="adminStatus" name="adminStatusKey" />
        <br />
        <button type="submit">Sign Up</button>
    </form>
</body>

</html>